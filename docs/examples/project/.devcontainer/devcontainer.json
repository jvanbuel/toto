// The same dev container your developers use (https://containers.dev). toto reads only two things
// from it: the published image (customizations.toto.image, or the top-level `image`) and
// `customizations.toto`. Everything else is for your developers; keys that act on the host
// (runArgs, mounts, privileged, ...) are never applied to tasks.
//
// With no published image, a contributor's machine prebuilds this file the way Codespaces does:
// build + onCreateCommand + updateContentCommand, snapshotted. postCreateCommand and later never run.
{
  "name": "acme-docs",
  "build": { "dockerfile": "Dockerfile" },
  "onCreateCommand": "pip install -r requirements.txt",
  "postCreateCommand": "echo 'developer-only setup'",
  "customizations": {
    "vscode": { "extensions": ["ms-python.python"] },
    "toto": {
      "id": "acme-docs",
      "name": "Acme Docs",
      "description": "Keeps the Acme documentation current: fixes broken examples and stale API references.",
      "public_key": "<hex key printed by `toto project-key project.key`>",
      "kinds": ["docs-fix"],
      "image": "ghcr.io/acme/toto-env:1.0",
      "agent": ".toto/agent"
    }
  }
}
